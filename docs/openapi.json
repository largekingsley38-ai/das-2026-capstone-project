        "tags": [
          "Bookings"
        ],
        "summary": "Pay for a booking (mock card)",
        "operationId": "pay",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "description": "Send `{ \"decline\": true }` to simulate a declined card: you get 402 and the booking stays pending. Send `{}` to pay. Paying twice never charges twice. (S07)",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Booking reference, for example `A4WMMBBT`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "decline": {
                    "type": "boolean",
                    "description": "true simulates a declined card."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The paid booking.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "booking": {
                      "$ref": "#/components/schemas/Booking"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `BAD_JSON`.",
