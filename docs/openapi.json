                }
              }
            }
          },
          "404": {
            "description": "It does not exist. Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{reference}/cancel": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Cancel a booking",
        "operationId": "cancel",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "description": "A pending booking gives its seats back. A paid booking is refunded by the refund rule. After the event has started it is refused.",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Booking reference, for example `A4WMMBBT`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The booking after cancelling.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "booking": {
                      "$ref": "#/components/schemas/Booking"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, or a bad or expired token. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Your role or ownership does not allow this. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist. Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Already cancelled, or the event has started. Possible codes: `INVALID_TRANSITION`, `EVENT_STARTED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/waitlist": {
      "post": {
        "tags": [
          "Waitlist"
        ],
        "summary": "Join the waitlist of a sold-out tier",
        "operationId": "joinWaitlist",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tierId",
                  "quantity"
                ],
                "properties": {
                  "tierId": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Your place in the line.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entry": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `BAD_JSON`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or a bad or expired token. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The tier still has seats, or you are already in line. Possible codes: `NOT_SOLD_OUT`, `ALREADY_ON_WAITLIST`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/waitlist/mine": {
      "get": {
        "tags": [
          "Waitlist"
        ],
        "summary": "My waitlist entries",
        "operationId": "myWaitlist",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Your entries.",
