  },
  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The token from signup or login."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "SOLD_OUT"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "att2@gmail.com"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "attendee",
              "organizer",
              "staff"
            ]
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "attendee",
              "organizer",
              "staff"
            ]
          }
        }
      },
      "AuthResult": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "NewEvent": {
        "type": "object",
        "required": [
          "title",
          "city",
          "startsAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Fit night"
          },
          "city": {
            "type": "string",
            "example": "Lagos"
          },
          "venue": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2027-12-05T17:00:00Z"
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          }
        }
      },
      "NewTier": {
        "type": "object",
        "required": [
          "name",
          "priceCents",
          "capacity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Regular"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "example": 500000
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "example": 100
          }
        }
      },
      "Tier": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer"
          },
          "capacity": {
            "type": "integer"
          },
          "sold": {
            "type": "integer"
          },
          "seatsLeft": {
            "type": "integer"
          }
        }
      },
      "NewBooking": {
        "type": "object",
        "required": [
          "tierId",
          "quantity"
        ],
        "properties": {
          "tierId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "example": "A4WMMBBT"
          },
          "tierId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "amountCents": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "cancelled",
              "refunded",
              "checked_in"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
